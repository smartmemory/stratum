{
  "name": "@smartmemory/stratum-ui",
  "version": "0.1.0",
  "description": "Stratum run view and gate inbox as React components fed by an injected DataClient, plus a standalone shell and a read-only local server.",
  "license": "BUSL-1.1",
  "author": "SmartMemory",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smartmemory/stratum.git",
    "directory": "ui"
  },
  "homepage": "https://github.com/smartmemory/stratum/tree/main/ui#readme",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./data-client": {
      "types": "./dist/data-client.d.ts",
      "import": "./dist/data-client.js"
    },
    "./styles.css": "./dist/styles.css",
    "./builder": {
      "types": "./dist/builder/index.d.ts",
      "import": "./dist/builder.js"
    },
    "./server": "./server/handler.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "server",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "serve": "node server/serve.mjs",
    "dev": "vite",
    "build": "vite build -c vite.lib.config.ts && tsc -p tsconfig.build.json",
    "build:shell": "vite build",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "dependencies": {
    "@dagrejs/dagre": "^2.0.4"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.0.2",
    "postcss": "^8.5.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "vitest": {
      "vite": "$vite"
    }
  }
}
