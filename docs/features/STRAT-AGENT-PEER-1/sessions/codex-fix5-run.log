}

export type PeerRecordFile = { pid: number; name: string; sock: string; registeredAt: string };
export interface PeerSidecarConfig {
  runDir: string;
  streamPath: string;
  childPid: number;
  childProcStartTime?: string;
  name: string;
  cwd: string;
  sessionsDir: string;
  sockDir: string;
  lingerMs?: number;
  firstLineDeadlineMs?: number;
}
