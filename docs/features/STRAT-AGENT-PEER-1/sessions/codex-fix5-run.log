    try { if ((await lstat(join(config.runDir,"peer.json"))).isFile()) pids.add(Number((await json(join(config.runDir,"peer.json"))).pid)); } catch { /* startup may fail */ }
    for (const name of await readdir(config.sessionsDir).catch(() => [])) {
