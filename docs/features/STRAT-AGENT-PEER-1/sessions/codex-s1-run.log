        const timeout = setTimeout(() => { socket.destroy(); resolve(); }, 5000);
        socket.once("connect", () => socket.end(
          (token ? JSON.stringify({type:"auth", token}) + "\n" : "") + JSON.stringify(frame) + "\n",
