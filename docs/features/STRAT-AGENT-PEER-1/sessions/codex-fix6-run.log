    91	    await chmod(config.sessionsDir,0o700).catch(() => undefined);
    92	    const pids = new Set<number>();
    93	    try { pids.add(Number(await readFile(join(config.runDir,"test-pid"),"utf8"))); } catch { /* spawn may fail */ }
    94	    try { if ((await lstat(join(config.runDir,"peer.json"))).isFile()) pids.add(Number((await json(join(config.runDir,"peer.json"))).pid)); } catch { /* startup may fail */ }
    95	    for (const name of await readdir(config.sessionsDir).catch(() => [])) {
    96	      if (!/^\d+\.json$/.test(name)) continue;
    97	      if (!(await lstat(join(config.sessionsDir,name)).catch(() => undefined))?.isFile()) continue;
    98	      const record = await json(join(config.sessionsDir,name)).catch(() => null);
    99	      if (record?.entrypoint === "stratum-peer") pids.add(Number(name.slice(0,-5)));
   100	    }
   101	    for (const pid of pids) {
   102	      try { process.kill(pid,"SIGTERM"); } catch { continue; }
   103	      const gone = async (): Promise<boolean> => { try { process.kill(pid,0); return false; } catch { return true; } };
   104	      try { await waitFor(gone, Boolean,7000); }
   105	      catch {
   106	        // Even a broken sidecar under test must not outlive the fixture.
   107	        try { process.kill(pid,"SIGKILL"); } catch { /* already exited */ }
   108	        await waitFor(gone, Boolean);
   109	      }
   110	    }
   111	  }
   112	  for (const child of children.splice(0)) {
   113	    if (child.exitCode === null && child.signalCode === null) {
   114	      const exited = once(child,"exit"); try { process.kill(-child.pid!,"SIGTERM"); } catch { child.kill(); } await exited;
   115	    }
   116	  }
   117	  for (const socket of sockets) socket.destroy(); sockets.clear();
   118	  await Promise.all(servers.splice(0).map(server => new Promise<void>(resolve => server.close(() => resolve()))));
   119	  await Promise.all(roots.splice(0).map(dir => rm(dir,{recursive:true,force:true})));
