   692	async function heldRequester(config: PeerSidecarConfig, pid = 987610): Promise<{sock: string; held: Socket[]; frames: Record<string,unknown>[]}> {
   693	  const sock = join(config.sockDir,`${pid}.sock`); const held: Socket[] = []; const frames: Record<string,unknown>[] = [];
   694	  const server = createServer({allowHalfOpen:true}, socket => {
   695	    held.push(socket); sockets.add(socket); socket.on("close",()=>sockets.delete(socket));
   696	    let pending = ""; socket.on("data",data => {
   697	      pending += data.toString(); let end: number;
   698	      while ((end = pending.indexOf("\n")) >= 0) { frames.push(JSON.parse(pending.slice(0,end))); pending = pending.slice(end+1); }
   699	    });
   700	  });
   701	  servers.push(server); server.listen(sock); await once(server,"listening");
   702	  return {sock,held,frames};
   703	}
