    56	  // Reject traversal before normalizing: it must not disguise an untrusted directory.
    57	  if (!isAbsolute(path) || path.includes("\0") || path.split("/").some(part => part === ".." || part === ".")) return undefined;
    58	  if (!/^\d+\.sock$/.test(basename(path))) return undefined;
    59	  const dir = dirname(path);
    60	  return dir === resolve(ownSockDir) || /^\/(?:private\/)?tmp\/cc-socks(?:-\d+)?$/.test(dir)
    61	    || /^\/run\/user\/\d+\/cc-socks$/.test(dir) ? path : undefined;
    62	}
    63	
    64	export async function readPeerToken(sessionsDir: string, sockPath: string): Promise<string | undefined> {
    65	  let names: string[];
    66	  try { names = await readdir(sessionsDir); } catch { return undefined; }
    67	  const suffix = `.${socketHash(sockPath)}.key`;
    68	  for (const name of names.filter(name => /^\d+\./.test(name) && name.endsWith(suffix))) {
    69	    try {
    70	      const path = join(sessionsDir, name);
    71	      const info = await lstat(path);
    72	      if (!info.isFile() || info.size > 4096) continue;
    73	      const file = await open(path, "r");
    74	      try {
    75	        if (!(await file.stat()).isFile() || (await file.stat()).size > 4096) continue;
    76	        const buffer = Buffer.alloc(4096);
    77	        const { bytesRead } = await file.read(buffer, 0, buffer.length, 0);
    78	        if ((await file.stat()).size > 4096) continue;
    79	        const value: unknown = JSON.parse(buffer.subarray(0, bytesRead).toString("utf8"));
    80	        const token = (value as { peerToken?: unknown } | null)?.peerToken;
    81	        if (typeof token === "string" && /^[0-9a-f]{32}$/.test(token)) return token;
    82	      } finally { await file.close(); }
    83	    } catch { /* Another session may rotate or remove its key during lookup. */ }
    84	  }
    85	  return undefined;
    86	}
    87	
    88	function pidIsDead(pid: number): boolean {
    89	  try { process.kill(pid, 0); return false; }
    90	  catch (error) { return (error as NodeJS.ErrnoException).code === "ESRCH"; }
    91	}
    92	export async function shouldRegister(sessionsDir: string, env: NodeJS.ProcessEnv): Promise<{ ok: true } | { ok: false; reason: string }> {
    93	  if (env.STRATUM_PEER_REGISTER === "0") return { ok: false, reason: "disabled" };
    94	  let names: string[];
    95	  try {
    96	    if (!(await stat(sessionsDir)).isDirectory()) return { ok: false, reason: "missing sessions directory" };
    97	    names = await readdir(sessionsDir);
    98	  } catch { return { ok: false, reason: "unreadable sessions directory" }; }
    99	  for (const name of names) {
   100	    if (!/^[1-9]\d*\.json$/.test(name)) continue;
   101	    try {
   102	      const path = join(sessionsDir, name);
   103	      const info = await lstat(path);
   104	      if (!info.isFile() || info.size > 262144) continue;
   105	      const record: unknown = JSON.parse(await readFile(path, "utf8"));
   106	      const protocol = (record as { peerProtocol?: unknown } | null)?.peerProtocol;
   107	      if (typeof protocol === "number" && protocol > 1 && !pidIsDead(Number(name.slice(0, -5)))) {
   108	        return { ok: false, reason: "unsupported live peer protocol" };
   109	      }
   110	    } catch { /* Malformed records are not evidence of a newer protocol. */ }
   111	  }
   112	  return { ok: true };
   113	}
   114	
   115	export async function sweepDeadStratumPeers(sessionsDir: string, _sockDir: string): Promise<number> {
   116	  const names = await readdir(sessionsDir);
   117	  let removed = 0;
   118	  for (const name of names) {
   119	    if (!/^[1-9]\d*\.json$/.test(name)) continue;
   120	    const pid = Number(name.slice(0, -5));
   121	    try {
   122	      const path = join(sessionsDir, name);
   123	      const info = await lstat(path);
   124	      if (!info.isFile() || info.size > 262144) continue;
   125	      const record: unknown = JSON.parse(await readFile(path, "utf8"));
   126	      if ((record as { entrypoint?: unknown } | null)?.entrypoint !== "stratum-peer" || !pidIsDead(pid)) continue;
   127	      try { await unlink(path); }
   128	      catch (error) {
   129	        if ((error as NodeJS.ErrnoException).code !== "ENOENT") {
   130	          console.error("peer sweep left record and dependents alone:", path, error);
   131	          continue;
   132	        }
   133	      }
   134	      const endpoint = (record as {messagingSocketPath?: unknown}).messagingSocketPath;
   135	      if (typeof endpoint === "string" && isAbsolute(endpoint) && !endpoint.includes("\0")) {
   136	        await unlink(join(sessionsDir, keyFileName(pid, endpoint))).catch(() => undefined);
   137	        if ((await lstat(endpoint).catch(() => undefined))?.isSocket()) {
   138	          await unlink(endpoint).catch(() => undefined);
   139	        }
   140	      }
   141	      removed++;
   142	    } catch { /* A concurrent sweep or malformed record must not affect other peers. */ }
   143	  }
   144	  return removed;
   145	}
   146	
   147	export type PeerRecordFile = { pid: number; name: string; sock: string; registeredAt: string };
   148	export interface PeerSidecarConfig {
   149	  runDir: string;
   150	  streamPath: string;
   151	  childPid: number;
   152	  childProcStartTime?: string;
   153	  name: string;
   154	  cwd: string;
   155	  sessionsDir: string;
   156	  sockDir: string;
   157	  lingerMs?: number;
   158	  firstLineDeadlineMs?: number;
   159	}
   160	export function sidecarEnv(config: PeerSidecarConfig): NodeJS.ProcessEnv {
   161	  return {
   162	    ...process.env,
   163	    STRATUM_PEER_RUN_DIR: config.runDir, STRATUM_PEER_STREAM: config.streamPath,
   164	    STRATUM_PEER_CHILD_PID: String(config.childPid), STRATUM_PEER_CHILD_START: config.childProcStartTime,
   165	    STRATUM_PEER_NAME: config.name, STRATUM_PEER_CWD: config.cwd,
   166	    STRATUM_PEER_SESSIONS_DIR: config.sessionsDir, STRATUM_PEER_SOCK_DIR: config.sockDir,
   167	    STRATUM_PEER_LINGER_MS: String(config.lingerMs ?? 15000),
   168	    STRATUM_PEER_FIRST_LINE_MS: String(config.firstLineDeadlineMs ?? 30000),
   169	  };
   170	}
   171	export function configFromEnv(env: NodeJS.ProcessEnv): PeerSidecarConfig {
   172	  const required = (key: string): string => {
   173	    const value = env[key];
   174	    if (!value) throw new Error(`Missing ${key}`);
   175	    return value;
   176	  };
   177	  const childPid = Number(required("STRATUM_PEER_CHILD_PID"));
   178	  const lingerMs = Number(env.STRATUM_PEER_LINGER_MS ?? 15000);
   179	  const firstLineDeadlineMs = Number(env.STRATUM_PEER_FIRST_LINE_MS ?? 30000);
   180	  if (!Number.isSafeInteger(childPid) || childPid <= 0 || !Number.isSafeInteger(lingerMs) || lingerMs < 0) throw new Error("Invalid peer pid or linger");

