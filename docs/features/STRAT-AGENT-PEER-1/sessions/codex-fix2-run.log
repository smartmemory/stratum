  expect((await readdir(dir)).sort()).toEqual([`${process.pid}.abc.key`,`${process.pid}.json`,"2147483646.abc.key","2147483646.json"].sort());
  expect((await readdir(socks)).sort()).toEqual([`${process.pid}.sock`,"2147483646.sock"].sort());
});

