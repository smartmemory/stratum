{
  "surface": 5,
  "shapeLanguage": "Same shape language as events.json. Each tool declares its request shape and one response shape per status variant; a response's status field is implicit. Undeclared keys are contract violations.",
  "tools": {
    "stratum_validate": {
      "request": { "spec": "any" },
      "responses": {
        "valid": {},
        "invalid": { "errors": "array" }
      }
    },
    "stratum_compile_speckit": {
      "request": { "tasks_dir": "string", "flow_name?": "string" },
      "responses": {
        "ok": { "yaml": "string", "flow_name": "string", "steps": "array" },
        "error": { "error_type": "string", "message": "string" }
      }
    },
    "stratum_plan": {
      "request": { "spec": "any", "input": "any", "workspaceRoot?": "string" },
      "responses": {
        "ready": { "runId": "string", "ready": "array", "ledger": { "spent": "object", "budget?": "object" } },
        "running": { "runId": "string", "ledger": { "spent": "object", "budget?": "object" } },
        "completed": { "runId": "string", "output": "any", "ledger": { "spent": "object", "budget?": "object" } },
        "failed": { "runId": "string", "failure": { "attempt": "number", "reason": "string" }, "ledger": { "spent": "object", "budget?": "object" } },
        "budget_exhausted": { "runId": "string", "failure": { "attempt": "number", "reason": "string" }, "ledger": { "spent": "object", "budget?": "object" } }
      }
    },
    "stratum_step_done": {
      "request": { "runId": "string", "stepId": "string", "result": { "output?": "any", "failure?": "string", "usage?": "object", "telemetry?": { "durationMs": "number", "model": "string", "effort?": "string" } } },
      "responses": {
        "ready": { "runId": "string", "ready": "array", "ledger": { "spent": "object", "budget?": "object" } },
        "running": { "runId": "string", "ledger": { "spent": "object", "budget?": "object" } },
        "completed": { "runId": "string", "output": "any", "ledger": { "spent": "object", "budget?": "object" } },
        "failed": { "runId": "string", "failure": { "attempt": "number", "reason": "string" }, "ledger": { "spent": "object", "budget?": "object" } },
        "budget_exhausted": { "runId": "string", "failure": { "attempt": "number", "reason": "string" }, "ledger": { "spent": "object", "budget?": "object" } }
      }
    },
    "stratum_commit": {
      "description": "Save a named checkpoint of the current flow state; state-only; no files are touched; the caller owns file-level undo.",
      "request": { "flow_id": "string", "label": "string" },
      "responses": {
        "committed": { "flow_id": "string", "label": "string", "step_number": "number", "current_step_id": "string|null", "checkpoints": "array" },
        "error": { "error_type": "string", "message": "string", "available?": "array" }
      }
    },
    "stratum_revert": {
      "description": "Roll back flow state to a named checkpoint; state-only; no files are touched; the caller owns file-level undo.",
      "request": { "flow_id": "string", "label": "string" },
      "responses": {
        "ready": { "runId": "string", "ready": "array", "ledger": { "spent": "object", "budget?": "object" }, "reverted_to": "string" },
        "running": { "runId": "string", "ledger": { "spent": "object", "budget?": "object" }, "reverted_to": "string" },
        "completed": { "runId": "string", "output": "any", "ledger": { "spent": "object", "budget?": "object" }, "reverted_to": "string" },
        "error": { "error_type": "string", "message": "string", "available?": "array" }
      }
    },
    "stratum_resume": {
      "request": { "runId": "string" },
      "responses": {
        "ready": { "runId": "string", "ready": "array", "ledger": { "spent": "object", "budget?": "object" } },
        "running": { "runId": "string", "ledger": { "spent": "object", "budget?": "object" } },
        "completed": { "runId": "string", "output": "any", "ledger": { "spent": "object", "budget?": "object" } },
        "failed": { "runId": "string", "failure": { "attempt": "number", "reason": "string" }, "ledger": { "spent": "object", "budget?": "object" } },
        "budget_exhausted": { "runId": "string", "failure": { "attempt": "number", "reason": "string" }, "ledger": { "spent": "object", "budget?": "object" } }
      }
    },
    "stratum_audit": {
      "request": { "runId": "string" },
      "responses": {
        "running": { "runId": "string", "events": "array", "steps": "object", "flowSpent": "object", "output?": "any" },
        "completed": { "runId": "string", "events": "array", "steps": "object", "flowSpent": "object", "output?": "any" },
        "failed": { "runId": "string", "events": "array", "steps": "object", "flowSpent": "object", "output?": "any" },
        "budget_exhausted": { "runId": "string", "events": "array", "steps": "object", "flowSpent": "object", "output?": "any" }
      }
    },
    "stratum_gate_resolve": {
      "request": { "runId": "string", "stepId": "string", "decision": "string" },
      "responses": {
        "ready": { "runId": "string", "ready": "array", "ledger": { "spent": "object", "budget?": "object" } },
        "running": { "runId": "string", "ledger": { "spent": "object", "budget?": "object" } },
        "completed": { "runId": "string", "output": "any", "ledger": { "spent": "object", "budget?": "object" } },
        "failed": { "runId": "string", "failure": { "attempt": "number", "reason": "string" }, "ledger": { "spent": "object", "budget?": "object" } },
        "budget_exhausted": { "runId": "string", "failure": { "attempt": "number", "reason": "string" }, "ledger": { "spent": "object", "budget?": "object" } }
      }
    },
    "stratum_flow_poll": {
      "request": { "runId": "string", "cursor?": "number" },
      "responses": {
        "running": { "runId": "string", "events": "array", "nextCursor": "number", "ledger": { "spent": "object", "budget?": "object" }, "output?": "any", "failure?": "object" },
        "completed": { "runId": "string", "events": "array", "nextCursor": "number", "ledger": { "spent": "object", "budget?": "object" }, "output?": "any", "failure?": "object" },
        "failed": { "runId": "string", "events": "array", "nextCursor": "number", "ledger": { "spent": "object", "budget?": "object" }, "output?": "any", "failure?": "object" },
        "budget_exhausted": { "runId": "string", "events": "array", "nextCursor": "number", "ledger": { "spent": "object", "budget?": "object" }, "output?": "any", "failure?": "object" }
      }
    },
    "stratum_flow_run_bg": {
      "request": { "spec": "any", "input": "any", "workspaceRoot?": "string" },
      "responses": {
        "running": { "runId": "string" }
      }
    },
    "stratum_flow_bg_poll": {
      "request": { "runId": "string", "cursor?": "number" },
      "responses": {
        "running": { "runId": "string", "events": "array", "nextCursor": "number", "ledger": { "spent": "object", "budget?": "object" }, "output?": "any", "failure?": "object", "bg": { "status": "string", "cancelRequested": "boolean", "pendingGates": "array", "gateStepId?": "string" } },
        "completed": { "runId": "string", "events": "array", "nextCursor": "number", "ledger": { "spent": "object", "budget?": "object" }, "output?": "any", "failure?": "object", "bg": { "status": "string", "cancelRequested": "boolean", "pendingGates": "array", "gateStepId?": "string" } },
        "failed": { "runId": "string", "events": "array", "nextCursor": "number", "ledger": { "spent": "object", "budget?": "object" }, "output?": "any", "failure?": "object", "bg": { "status": "string", "cancelRequested": "boolean", "pendingGates": "array", "gateStepId?": "string" } },
        "budget_exhausted": { "runId": "string", "events": "array", "nextCursor": "number", "ledger": { "spent": "object", "budget?": "object" }, "output?": "any", "failure?": "object", "bg": { "status": "string", "cancelRequested": "boolean", "pendingGates": "array", "gateStepId?": "string" } }
      }
    },
    "stratum_flow_cancel_bg": {
      "request": { "runId": "string" },
      "responses": {
        "running": {},
        "completed": {},
        "failed": {},
        "budget_exhausted": {},
        "cancelled": {}
      }
    },
    "stratum_agent_run": {
      "request": { "agent": "string", "prompt": "string", "cwd": "string", "model?": "string", "sandboxMode?": "string", "background?": "boolean" },
      "responses": {
        "complete": { "text": "string", "usage": "object", "telemetry": { "durationMs": "number", "model": "string", "effort?": "string" } },
        "bg_started": { "runId": "string", "pid": "number", "streamPath": "string" }
      }
    },
    "stratum_agent_poll": {
      "request": { "runId": "string" },
      "responses": {
        "not_found": { "runId": "string" },
        "running": { "runId": "string", "textTail": "string", "eventsSeen": "number", "streamPath": "string" },
        "complete": { "runId": "string", "text": "string", "usage": "object", "exitCode": "number", "telemetry": { "durationMs": "number", "model": "string", "effort?": "string" } },
        "error": { "runId": "string", "textTail": "string", "stderrTail": "string", "reason?": "string", "exitCode?": "number", "eventsSeen?": "number", "streamPath?": "string", "telemetry?": { "durationMs": "number", "model": "string", "effort?": "string" } }
      }
    },
    "stratum_cancel_agent_run": {
      "request": { "runId": "string" },
      "responses": {
        "cancelled": { "runId": "string" },
        "already_complete": { "runId": "string" },
        "already_error": { "runId": "string" },
        "not_found": { "runId": "string" }
      }
    },
    "stratum_guard_register": {
      "request": { "resource_id": "string", "graph": "object", "edge_predicates": "object", "initial": "string", "terminal?": "array|null", "stakes?": "object|null", "workspace_root?": "string|null" },
      "responses": {
        "registered": { "guard_id": "string", "checksum": "string" },
        "exists": { "guard_id": "string", "checksum": "string" },
        "error": { "error_type": "string", "message": "string" }
      }
    },
    "stratum_guard_transition": {
      "request": { "resource_id": "string", "from_state": "string", "to_state": "string", "artifacts": "object", "modified_files?": "array|null", "idempotency_key?": "string|null", "resolved_by?": "string" },
      "responses": {
        "applied": { "verdict": "object", "ledger_ref": "string", "current_state": "string" },
        "refused": { "verdict": "object", "ledger_ref": "string", "current_state": "string" },
        "replayed": { "verdict": "object", "ledger_ref": "string", "current_state": "string" },
        "error": { "error_type": "string", "message": "string" }
      }
    },
    "stratum_guard_override": {
      "request": { "resource_id": "string", "from_state": "string", "to_state": "string", "override_token": "string", "rationale": "string", "resolved_by?": "string" },
      "responses": {
        "deviation": { "ledger_ref": "string", "current_state": "string", "rationale": "string" },
        "error": { "error_type": "string", "message": "string" }
      }
    },
    "stratum_guard_migrate": {
      "request": { "resource_id": "string", "new_graph": "object", "new_edge_predicates": "object", "override_token": "string", "rationale": "string", "new_terminal?": "array|null", "new_stakes?": "object|null" },
      "responses": {
        "migrated": { "checksum": "string", "graph_version": "number", "ledger_ref": "string", "rationale": "string" },
        "error": { "error_type": "string", "message": "string" }
      }
    },
    "stratum_guard_history": {
      "request": { "resource_id": "string" },
      "responses": {
        "success": { "resource_id": "string", "current_state": "string", "graph_version": "number", "ledger": "array" },
        "error": { "error_type": "string", "message": "string" }
      }
    }
  }
}
