{
  "surface": 1,
  "shapeLanguage": "Same shape language as events.json. Each tool declares its request shape and one response shape per status variant; a response's status field is implicit. Undeclared keys are contract violations.",
  "tools": {
    "stratum_validate": {
      "request": { "spec": "any" },
      "responses": {
        "valid": {},
        "invalid": { "errors": "array" }
      }
    },
    "stratum_plan": {
      "request": { "spec": "any", "input": "any", "workspaceRoot?": "string" },
      "responses": {
        "ready": { "runId": "string", "ready": "array", "ledger": { "spent": "object", "budget?": "object" } },
        "running": { "runId": "string", "ledger": { "spent": "object", "budget?": "object" } },
        "completed": { "runId": "string", "output": "any", "ledger": { "spent": "object", "budget?": "object" } },
        "failed": { "runId": "string", "failure": { "attempt": "number", "reason": "string" }, "ledger": { "spent": "object", "budget?": "object" } },
        "budget_exhausted": { "runId": "string", "failure": { "attempt": "number", "reason": "string" }, "ledger": { "spent": "object", "budget?": "object" } }
      }
    },
    "stratum_step_done": {
      "request": { "runId": "string", "stepId": "string", "result": { "output?": "any", "failure?": "string", "usage?": "object", "telemetry?": { "durationMs": "number", "model": "string", "effort?": "string" } } },
      "responses": {
        "ready": { "runId": "string", "ready": "array", "ledger": { "spent": "object", "budget?": "object" } },
        "running": { "runId": "string", "ledger": { "spent": "object", "budget?": "object" } },
        "completed": { "runId": "string", "output": "any", "ledger": { "spent": "object", "budget?": "object" } },
        "failed": { "runId": "string", "failure": { "attempt": "number", "reason": "string" }, "ledger": { "spent": "object", "budget?": "object" } },
        "budget_exhausted": { "runId": "string", "failure": { "attempt": "number", "reason": "string" }, "ledger": { "spent": "object", "budget?": "object" } }
      }
    },
    "stratum_resume": {
      "request": { "runId": "string" },
      "responses": {
        "ready": { "runId": "string", "ready": "array", "ledger": { "spent": "object", "budget?": "object" } },
        "running": { "runId": "string", "ledger": { "spent": "object", "budget?": "object" } },
        "completed": { "runId": "string", "output": "any", "ledger": { "spent": "object", "budget?": "object" } },
        "failed": { "runId": "string", "failure": { "attempt": "number", "reason": "string" }, "ledger": { "spent": "object", "budget?": "object" } },
        "budget_exhausted": { "runId": "string", "failure": { "attempt": "number", "reason": "string" }, "ledger": { "spent": "object", "budget?": "object" } }
      }
    },
    "stratum_audit": {
      "request": { "runId": "string" },
      "responses": {
        "running": { "runId": "string", "events": "array", "steps": "object", "flowSpent": "object", "output?": "any" },
        "completed": { "runId": "string", "events": "array", "steps": "object", "flowSpent": "object", "output?": "any" },
        "failed": { "runId": "string", "events": "array", "steps": "object", "flowSpent": "object", "output?": "any" },
        "budget_exhausted": { "runId": "string", "events": "array", "steps": "object", "flowSpent": "object", "output?": "any" }
      }
    },
    "stratum_gate_resolve": {
      "request": { "runId": "string", "stepId": "string", "decision": "string" },
      "responses": {
        "ready": { "runId": "string", "ready": "array", "ledger": { "spent": "object", "budget?": "object" } },
        "running": { "runId": "string", "ledger": { "spent": "object", "budget?": "object" } },
        "completed": { "runId": "string", "output": "any", "ledger": { "spent": "object", "budget?": "object" } },
        "failed": { "runId": "string", "failure": { "attempt": "number", "reason": "string" }, "ledger": { "spent": "object", "budget?": "object" } },
        "budget_exhausted": { "runId": "string", "failure": { "attempt": "number", "reason": "string" }, "ledger": { "spent": "object", "budget?": "object" } }
      }
    },
    "stratum_flow_poll": {
      "request": { "runId": "string", "cursor?": "number" },
      "responses": {
        "running": { "runId": "string", "events": "array", "nextCursor": "number", "ledger": { "spent": "object", "budget?": "object" }, "output?": "any", "failure?": "object" },
        "completed": { "runId": "string", "events": "array", "nextCursor": "number", "ledger": { "spent": "object", "budget?": "object" }, "output?": "any", "failure?": "object" },
        "failed": { "runId": "string", "events": "array", "nextCursor": "number", "ledger": { "spent": "object", "budget?": "object" }, "output?": "any", "failure?": "object" },
        "budget_exhausted": { "runId": "string", "events": "array", "nextCursor": "number", "ledger": { "spent": "object", "budget?": "object" }, "output?": "any", "failure?": "object" }
      }
    },
    "stratum_agent_run": {
      "request": { "agent": "string", "prompt": "string", "cwd": "string", "model?": "string", "sandboxMode?": "string", "background?": "boolean" },
      "responses": {
        "complete": { "text": "string", "usage": "object", "telemetry": { "durationMs": "number", "model": "string", "effort?": "string" } },
        "bg_started": { "runId": "string", "pid": "number", "streamPath": "string" }
      }
    },
    "stratum_agent_poll": {
      "request": { "runId": "string" },
      "responses": {
        "not_found": { "runId": "string" },
        "running": { "runId": "string", "textTail": "string", "eventsSeen": "number", "streamPath": "string" },
        "complete": { "runId": "string", "text": "string", "usage": "object", "exitCode": "number", "telemetry": { "durationMs": "number", "model": "string", "effort?": "string" } },
        "error": { "runId": "string", "textTail": "string", "stderrTail": "string", "reason?": "string", "exitCode?": "number", "eventsSeen?": "number", "streamPath?": "string", "telemetry?": { "durationMs": "number", "model": "string", "effort?": "string" } }
      }
    },
    "stratum_cancel_agent_run": {
      "request": { "runId": "string" },
      "responses": {
        "cancelled": { "runId": "string" },
        "already_complete": { "runId": "string" },
        "already_error": { "runId": "string" },
        "not_found": { "runId": "string" }
      }
    }
  }
}
