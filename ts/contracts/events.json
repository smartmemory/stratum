{
  "events": 6,
  "shapeLanguage": "Each kind maps to the full event payload shape minus the implicit {at: string, type: string}. Leaf types: number|string|boolean|object|array|null|any, unions with '|', optional keys end in '?', nested objects are declared inline. Undeclared keys are contract violations.",
  "kinds": {
    "planned": {},
    "ready": { "stepId": "string", "detail": { "attempt": "number", "lessons?": { "$array": "string" }, "lessonsSuppressed?": { "$array": { "revisionId": "string", "reason": "string" } } } },
    "result": {
      "stepId": "string",
      "detail": {
        "attempt": "number",
        "result?": "any",
        "failure?": { "attempt": "number", "reason": "string" },
        "iterate?": { "iteration": "number", "max": "number" }
      }
    },
    "judged": {
      "stepId": "string",
      "detail": {
        "statement": "string",
        "holds": "boolean",
        "reason": "string",
        "stakes": "string",
        "model": "string",
        "usage": { "tokens": "number", "usd": "number" },
        "itemIndex?": "number",
        "stage?": "number"
      }
    },
    "routed": {
      "stepId": "string",
      "detail": { "target": "string", "failure": { "attempt": "number", "reason": "string" } }
    },
    "skipped": { "stepId": "string", "detail?": { "reason?": "string" } },
    "resumed": {},
    "completed": { "detail": { "output": "any" } },
    "failed": { "detail": { "attempt": "number", "reason": "string" } },
    "budget_exhausted": { "detail": { "attempt": "number", "reason": "string" } },
    "gate_waiting": { "stepId": "string" },
    "gate_resolved": { "stepId": "string", "detail": { "decision": "string", "target": "string|null" } },
    "fanout_item_ready": { "stepId": "string", "detail": { "itemIndex": "number", "lessons?": { "$array": "string" }, "lessonsSuppressed?": { "$array": { "revisionId": "string", "reason": "string" } } } },
    "fanout_item_dispatched": {
      "stepId": "string",
      "detail": { "itemIndex": "number", "stage": "number", "attempt": "number", "lessons?": { "$array": "string" }, "lessonsSuppressed?": { "$array": { "revisionId": "string", "reason": "string" } } }
    },
    "fanout_attempt_result": {
      "stepId": "string",
      "detail": {
        "itemIndex": "number",
        "stage": "number",
        "attempt": "number",
        "success": "boolean",
        "failure?": { "kind": "string", "reason": "string" }
      }
    },
    "fanout_item_skipped": { "stepId": "string", "detail": { "itemIndex": "number", "stage": "number" } },
    "fanout_ledger_debit": {
      "stepId": "string",
      "detail": { "itemIndex": "number", "amount": "object", "source?": "string" }
    },
    "fanout_merge": {
      "stepId": "string",
      "detail": { "itemIndex": "number", "success": "boolean", "reason?": "string" }
    },
    "usage_debit": {
      "stepId?": "string",
      "detail": {
        "seq": "number",
        "dispatchId": "string",
        "source": "string",
        "amount": "object",
        "model": "string",
        "effort?": "string",
        "durationMs": "number",
        "epoch?": "number",
        "attempt?": "number",
        "item?": { "itemIndex": "number", "stage": "number", "generation": "number" },
        "split?": { "input": "number", "output": "number", "cacheRead?": "number", "cacheCreation?": "number" },
        "usdSource?": "string",
        "reportedAt?": "string"
      }
    },
    "step_reset": {
      "stepId": "string",
      "detail": {
        "reason": "string",
        "reset": { "$array": { "stepId": "string", "fromEpoch": "number", "toEpoch": "number" } },
        "subflowsDropped": { "$array": "string" }
      }
    },
    "checkpoint_reverted": {
      "detail": {
        "label": "string",
        "receiptsAtRevert": "number",
        "stepsRestored": { "$array": "string" }
      }
    },
    "carry_updated": {
      "stepId?": "string",
      "detail": {
        "name": "string",
        "reason": "string",
        "provenance": {
          "kind": "string",
          "sourceStep?": "string",
          "sourceEpoch?": "number",
          "gate?": "string",
          "gateToken?": "string",
          "round?": "number",
          "at": "string"
        }
      }
    },
    "flow_cancelled": {
      "detail": {
        "by": "string",
        "reason?": "string",
        "burned": {
          "steps": { "$array": "string" },
          "items": "number"
        }
      }
    },
    "sandbox_policy": {
      "stepId": "string",
      "detail": {
        "attempt": "number",
        "itemIndex?": "number",
        "stage?": "number",
        "policy": "object",
        "provenance": "object"
      }
    }
  }
}
