{
  "name": "@smartmemory/stratum",
  "version": "0.4.1",
  "description": "Stratum engine: your agent proposes the step, Stratum decides whether it actually finished. Typed, resumable, postcondition-enforced workflows for AI agents.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smartmemory/stratum.git",
    "directory": "ts"
  },
  "bin": {
    "stratum": "./dist/cli/stratum.js",
    "stratum-mcp": "./dist/mcp/main.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "build": "node scripts/prepare-dist.mjs --clean && tsc -p tsconfig.build.json && node scripts/prepare-dist.mjs",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.11",
    "@ai-sdk/openai": "^4.0.11",
    "@anthropic-ai/claude-agent-sdk": "0.3.206",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/codex-sdk": "0.144.3",
    "ai": "^7.0.19",
    "js-tiktoken": "^1.0.21",
    "yaml": "^2.9.0",
    "zod": "^3.25.0"
  },
  "overrides": {
    "@anthropic-ai/sdk": "0.110.0",
    "@anthropic-ai/claude-agent-sdk": {
      "zod": "$zod"
    }
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
